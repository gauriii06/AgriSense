# Copy this file to .env and fill in real values. Never commit .env.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_EXPIRY_HOURS=72

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agrisense

# --- Weather API (OpenWeatherMap) ---
# Leave blank to use the built-in fallback weather dataset
OPENWEATHER_API_KEY=

# --- Market data ---
# Leave blank to use bundled demo market data
AGMARKNET_API_KEY=
